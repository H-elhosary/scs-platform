# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret Keys — REQUIRED, no insecure default. Generate a unique value per app/environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_generated_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_generated_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Medical data encryption key (AES-256-GCM) — REQUIRED, must be exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
MEDICAL_ENCRYPTION_KEY=replace_with_a_generated_32_byte_key

# PostgreSQL Configuration (Optional: If not provided, the server will fall back to In-Memory DB mode)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_clinic_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# 2FA Verification Settings
2FA_MOCK_OTP=123456
2FA_EXPIRY_MINUTES=5

# Webhook signature verification (Optional — leave unset to accept unverified
# requests with a warning logged, current default until real provider
# credentials exist).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TELEGRAM_WEBHOOK_SECRET=
PAYMOB_HMAC_SECRET=

# Server Configuration
PORT=3002
NODE_ENV=development

# JWT Secret Keys — REQUIRED, no insecure default. Generate a unique value per app/environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_generated_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_generated_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Medical data encryption key (AES-256-GCM) — REQUIRED, must be exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
MEDICAL_ENCRYPTION_KEY=replace_with_a_generated_32_byte_key

# PostgreSQL Configuration (Optional: If not provided, falls back to In-Memory DB mode)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=smart_clinic_db
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password

# 2FA Verification Settings
2FA_EXPIRY_MINUTES=5

# IP/VPN Whitelist (Optional — leave empty/unset to allow all IPs, current default).
# Comma-separated IPv4 addresses/CIDRs, e.g.: ADMIN_IP_ALLOWLIST=203.0.113.4,10.8.0.0/24
ADMIN_IP_ALLOWLIST=

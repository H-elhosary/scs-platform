# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret Keys
JWT_ACCESS_SECRET=your_jwt_access_secret_key_12345
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# PostgreSQL Configuration (Optional: If not provided, falls back to In-Memory DB mode)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=smart_clinic_db
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password

# 2FA Verification Settings (not used in clinic app)
2FA_MOCK_OTP=123456
2FA_EXPIRY_MINUTES=5

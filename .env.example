# Secrets for docker-compose.yml. Copy this file to ".env" and fill in real generated values —
# never commit the real ".env". Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"          # JWT secrets
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"       # 32-byte encryption key

POSTGRES_PASSWORD=replace_with_a_generated_db_password

JWT_ACCESS_SECRET=replace_with_a_generated_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_generated_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

MEDICAL_ENCRYPTION_KEY=replace_with_a_generated_32_byte_key
